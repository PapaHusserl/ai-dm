#main {
    height: 1fr;
}

#left {
    width: 1fr;
}

#feed {
    height: 1fr;
    border: round $primary;
    padding: 0 1;
}

#choices {
    height: auto;
    max-height: 12;
    overflow-y: auto;
    padding: 0 1;
    border: round $accent;
}

#input {
    dock: bottom;
}

#side {
    display: none;
    width: 58;
    max-width: 80%;
    height: 100%;
    overflow-y: auto;
    background: $surface;
}

#side.open {
    display: block;
    dock: right;
}

.wide #side {
    display: block;
    dock: none;
}

#side Static {
    height: auto;
    border: round $primary;
    padding: 0 1;
}

#picture {
    display: none;
    height: auto;
    max-height: 16;
}

#hero {
    max-height: 8;
    overflow-y: auto;
}

#side #actions {
    display: none;
    height: auto;
    max-height: 24;
    overflow-y: auto;
    border: round $primary;
    padding: 0 1;
}

#side #actions Static {
    border: none;
    padding: 0;
}

#actions MenuLine {
    height: auto;
}

#actions MenuLine:hover {
    background: $boost;
}

#side #combat {
    display: none;
    height: 1fr;
    min-height: 4;
    overflow-y: auto;
}

#rolls {
    height: 1fr;
    min-height: 5;
    border: round $primary;
}

#combat-log {
    height: 1fr;
    min-height: 6;
    border: round $primary;
}

#gains {
    display: none;
}

#status {
    height: 1;
    padding: 0 1;
    background: $boost;
}

#choices Choice {
    height: auto;
}

#choices Choice:hover {
    background: $boost;
}

#modal {
    width: 90%;
    max-width: 100;
    height: auto;
    max-height: 90%;
    border: round $primary;
    background: $surface;
    padding: 0 1;
}

#modal-body {
    height: auto;
    max-height: 30;
}

#modal-close {
    width: 100%;
}

TextModal {
    align: center middle;
}

ModelModal {
    align: center middle;
}

#model-list {
    height: auto;
    max-height: 20;
}

SpellModal {
    align: center middle;
}

#spell-list {
    height: auto;
    max-height: 14;
}

#spell-body {
    height: auto;
    max-height: 12;
    border-top: solid $primary;
}

MoreModal {
    align: center middle;
}

MoreModal #modal {
    height: 90%;
}

#more-list {
    height: 1fr;
}
